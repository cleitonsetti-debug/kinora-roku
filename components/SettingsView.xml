<?xml version="1.0" encoding="UTF-8"?>
<component name="SettingsView" extends="Group">
    <interface>
        <field id="action" type="string" alwaysNotify="true"/>
        <function name="focusView"/>
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0DFF"/>
        <Poster id="glow" uri="pkg:/images/glow_s.png" loadDisplayMode="scaleToFill" translation="[-300, 200]" width="1500" height="1000" opacity="0.30" blendColor="0x8338ECFF"/>
        <Label id="titleLabel" text="" translation="[80, 44]" width="800" height="70" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="48"/>
        </Label>
        <Label id="subLabel" text="" translation="[80, 110]" width="1400" height="36" color="0x9A9AA6FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="22"/>
        </Label>

        <MarkupList id="cats"
            translation="[70, 170]"
            itemComponentName="SettingsCat"
            itemSize="[520, 92]"
            numRows="8"
            focusBitmapUri="pkg:/images/key_focus.9.png"/>
        <MarkupList id="rows"
            translation="[640, 170]"
            itemComponentName="SettingRow"
            itemSize="[1180, 100]"
            numRows="8"
            focusBitmapUri="pkg:/images/key_focus.9.png"/>

        <Label id="hintLabel" text="" translation="[80, 1000]" width="1760" height="40" color="0x9A9AA6FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="22"/>
        </Label>
        <Timer id="pinTimer" repeat="false" duration="0.4"/>
    </children>
    <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
    <script type="text/brightscript" uri="pkg:/source/I18n.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Storage.brs"/>
    <script type="text/brightscript" uri="pkg:/source/AddonStore.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Settings.brs"/>
    <script type="text/brightscript" uri="pkg:/components/SettingsView.brs"/>
</component>
