<?xml version="1.0" encoding="UTF-8"?>
<component name="HomeView" extends="Group">
    <interface>
        <field id="itemSelected" type="assocarray" alwaysNotify="true"/>
        <field id="menuAction" type="string" alwaysNotify="true"/>
        <function name="focusView"/>
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0DFF"/>
        <Group id="heroZoom" scaleRotateCenter="[960, 300]">
            <Poster id="heroBackdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom"/>
            <Poster id="heroBackdropB" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0"/>
        </Group>
        <Poster id="glow" uri="pkg:/images/glow_s.png" loadDisplayMode="scaleToFill" translation="[-260, 20]" width="1500" height="1000" opacity="0.5" blendColor="0x8338ECFF"/>
        <Poster uri="pkg:/images/grad_left_s.png" loadDisplayMode="scaleToFill" width="1920" height="1080"/>
        <Poster uri="pkg:/images/grad_bottom_s.png" loadDisplayMode="scaleToFill" width="1920" height="1080"/>
        <Poster uri="pkg:/images/grad_top_s.png" loadDisplayMode="scaleToFill" width="1920" height="200"/>

        <Label id="brand" text="KINORA" translation="[80, 42]" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="30"/>
        </Label>
        <Poster uri="pkg:/images/nav_glass.png" translation="[590, 28]" width="1262" height="72"/>
        <MarkupGrid id="nav"
            translation="[600, 36]"
            itemComponentName="NavItem"
            itemSize="[170, 56]"
            itemSpacing="[8, 0]"
            numColumns="7"
            numRows="1"
            focusBitmapUri="pkg:/images/pill_soft.9.png"/>
        <Poster id="navIndicator" uri="pkg:/images/bar_fill.9.png" translation="[640, 104]" width="90" height="6" blendColor="0x8338ECFF"/>

        <MarkupGrid id="filterBar"
            translation="[1120, 112]"
            itemComponentName="ChipItem"
            itemSize="[360, 52]"
            itemSpacing="[12, 0]"
            numColumns="2"
            numRows="1"
            focusBitmapUri="pkg:/images/key_focus.9.png"
            visible="false"/>

        <Label id="heroTitle" translation="[80, 84]" width="1000" height="140" maxLines="2" vertAlign="bottom" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="46"/>
        </Label>
        <Poster id="kindBg" uri="pkg:/images/badge_glass.9.png" translation="[80, 228]" width="100" height="38" visible="false"/>
        <Label id="kindLabel" text="" translation="[96, 228]" height="38" vertAlign="center" color="0xFFFFFFFF" visible="false">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="19"/>
        </Label>
        <Poster id="imdbBg" uri="pkg:/images/badge_yellow.9.png" translation="[200, 228]" width="100" height="38" visible="false"/>
        <Label id="imdbLabel" text="" translation="[216, 228]" height="38" vertAlign="center" color="0x0A0A0DFF" visible="false">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="19"/>
        </Label>
        <Label id="heroMeta" translation="[80, 228]" width="1000" height="36" maxLines="1" color="0xC9C9D2FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="22"/>
        </Label>
        <Label id="heroDesc" translation="[80, 270]" width="860" height="66" wrap="true" maxLines="2" color="0xB4B4BFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="21"/>
        </Label>

        <Group id="rowsGroup" translation="[0, 0]"/>
        <BusySpinner id="busy" uri="pkg:/images/spinner.png" translation="[912, 620]" visible="false"/>
        <Label id="statusLabel" text="" translation="[400, 560]" width="1100" horizAlign="center" wrap="true" maxLines="4" color="0xC9C9D2FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="28"/>
        </Label>
        <Group id="dots" translation="[80, 446]" visible="false"/>
        <HeroButton id="heroBtn" translation="[80, 354]" visible="false"/>
        <HeroButton id="heroBtn2" translation="[416, 354]" visible="false"/>

        <Group id="filterPanel" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000C0"/>
            <Rectangle translation="[560, 90]" width="800" height="900" color="0x14141AFF"/>
            <Label id="filterTitle" text="" translation="[610, 120]" width="700" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="32"/>
            </Label>
            <LabelList id="filterList"
                translation="[600, 200]"
                itemSize="[720, 60]"
                numRows="11"
                textHorizOffset="24"
                color="0xD8D8E0FF"
                focusedColor="0x0A0A0DFF"
                focusBitmapUri="pkg:/images/pill_white.9.png"
                focusFootprintBitmapUri="pkg:/images/pill_dim.9.png"/>
        </Group>
        <Animation id="fadeIn" duration="0.9" easeFunction="inOutQuad" repeat="false">
            <FloatFieldInterpolator fieldToInterp="heroBackdropB.opacity" key="[0.0, 1.0]" keyValue="[0.0, 1.0]"/>
        </Animation>
        <Animation id="fadeOut" duration="0.9" easeFunction="inOutQuad" repeat="false">
            <FloatFieldInterpolator fieldToInterp="heroBackdropB.opacity" key="[0.0, 1.0]" keyValue="[1.0, 0.0]"/>
        </Animation>
        <Animation id="zoomAnim" duration="11" easeFunction="linear" repeat="false">
            <Vector2DFieldInterpolator fieldToInterp="heroZoom.scale" key="[0.0, 1.0]" keyValue="[[1.0, 1.0], [1.07, 1.07]]"/>
        </Animation>
        <Timer id="carouselTimer" repeat="true" duration="8" control="start"/>
        <Timer id="debounce" repeat="false" duration="0.4"/>
        <Timer id="heroTimer" repeat="false" duration="0.3"/>
    </children>
    <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
    <script type="text/brightscript" uri="pkg:/source/I18n.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Storage.brs"/>
    <script type="text/brightscript" uri="pkg:/source/AddonStore.brs"/>
    <script type="text/brightscript" uri="pkg:/components/HomeHero.brs"/>
    <script type="text/brightscript" uri="pkg:/components/HomeFilters.brs"/>
    <script type="text/brightscript" uri="pkg:/components/HomeView.brs"/>
</component>
