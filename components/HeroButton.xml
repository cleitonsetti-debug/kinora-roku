<?xml version="1.0" encoding="UTF-8"?>
<component name="HeroButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="refresh"/>
        <field id="active" type="boolean" onChange="refresh"/>
    </interface>
    <children>
        <Poster id="bg" uri="pkg:/images/herobtn_glass.png" width="320" height="72"/>
        <Poster id="icon" uri="pkg:/images/ic_info.png" translation="[100, 19]" width="34" height="34" loadDisplayMode="scaleToFit"/>
        <Label id="label" text="" translation="[150, 0]" height="72" vertAlign="center" maxLines="1" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="26"/>
        </Label>
    </children>
    <script type="text/brightscript" uri="pkg:/components/HeroButton.brs"/>
</component>
