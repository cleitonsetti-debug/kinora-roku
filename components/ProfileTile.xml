<?xml version="1.0" encoding="UTF-8"?>
<component name="ProfileTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange"/>
        <field id="width" type="float" onChange="onLayout"/>
        <field id="height" type="float" onChange="onLayout"/>
    </interface>
    <children>
        <Poster id="avatar" uri="pkg:/images/avatar_circle.png" translation="[50, 20]" width="160" height="160" blendColor="0x8338ECFF"/>
        <Label id="initial" text="" translation="[50, 20]" width="160" height="160" horizAlign="center" vertAlign="center" maxLines="1" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="72"/>
        </Label>
        <Label id="name" text="" translation="[0, 192]" width="260" height="44" horizAlign="center" maxLines="1" color="0xF2F2F5FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="26"/>
        </Label>
        <Label id="kids" text="" translation="[0, 238]" width="260" height="32" horizAlign="center" maxLines="1" color="0xA78BFAFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="19"/>
        </Label>
    </children>
    <script type="text/brightscript" uri="pkg:/components/ProfileTile.brs"/>
</component>
