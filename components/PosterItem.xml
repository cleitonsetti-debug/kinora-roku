<?xml version="1.0" encoding="UTF-8"?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange"/>
        <field id="width" type="float" onChange="onLayout"/>
        <field id="height" type="float" onChange="onLayout"/>
    </interface>
    <children>
        <Rectangle id="placeholder" color="0x1C1C22FF" width="160" height="240"/>
        <Poster id="poster" width="160" height="240" loadDisplayMode="scaleToZoom"/>
        <Rectangle id="progressBg" color="0x00000099" width="160" height="6" visible="false"/>
        <Rectangle id="progressFg" color="0xFFFFFFFF" width="0" height="6" visible="false"/>
        <Poster id="mask" uri="pkg:/images/mask_round.9.png" width="160" height="240"/>
        <Label id="titleLabel" translation="[2, 246]" width="156" height="58" color="0xF2F2F5FF" wrap="true" maxLines="2" vertAlign="top" visible="false">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="17"/>
        </Label>
        <Timer id="retryTimer" repeat="false" duration="1.5"/>
    </children>
    <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
    <script type="text/brightscript" uri="pkg:/components/PosterItem.brs"/>
</component>
