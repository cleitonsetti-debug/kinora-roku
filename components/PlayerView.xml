<?xml version="1.0" encoding="UTF-8"?>
<component name="PlayerView" extends="Group">
    <interface>
        <field id="request" type="assocarray" onChange="onRequest"/>
        <field id="finished" type="boolean" alwaysNotify="true"/>
        <function name="focusView"/>
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF"/>
        <Video id="video" translation="[0, 0]" width="1920" height="1080"/>
        <Timer id="saveTimer" repeat="true" duration="15"/>
    </children>
    <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
    <script type="text/brightscript" uri="pkg:/source/I18n.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Storage.brs"/>
    <script type="text/brightscript" uri="pkg:/components/PlayerView.brs"/>
</component>
