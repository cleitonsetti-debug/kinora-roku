<?xml version="1.0" encoding="UTF-8"?>
<component name="DetailsView" extends="Group">
    <interface>
        <field id="item" type="assocarray" onChange="onItem"/>
        <field id="playRequest" type="assocarray" alwaysNotify="true"/>
        <function name="focusView"/>
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x0A0A0DFF"/>
        <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom"/>
        <Poster uri="pkg:/images/grad_left.png" width="1920" height="1080"/>
        <Poster uri="pkg:/images/grad_bottom.png" width="1920" height="1080"/>
        <Poster uri="pkg:/images/grad_top.png" width="1920" height="200"/>

        <Label id="titleLabel" translation="[90, 100]" width="1100" height="160" maxLines="2" vertAlign="bottom" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="50"/>
        </Label>
        <Label id="metaLabel" translation="[90, 272]" width="1100" height="36" maxLines="1" color="0xC9C9D2FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="23"/>
        </Label>
        <Label id="descLabel" translation="[90, 322]" width="900" height="130" wrap="true" maxLines="4" vertAlign="top" color="0xB4B4BFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="21"/>
        </Label>
        <Label id="infoLabel" text="" translation="[90, 520]" width="1100" color="0xC9C9D2FF" visible="false">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="28"/>
        </Label>

        <LabelList id="watchBtn"
            translation="[90, 500]"
            itemSize="[300, 64]"
            numRows="1"
            textHorizOffset="100"
            color="0xFFFFFFFF"
            focusedColor="0x0A0A0DFF"
            focusBitmapUri="pkg:/images/pill_white.9.png"
            focusFootprintBitmapUri="pkg:/images/pill_dim.9.png"
            visible="false"/>

        <RowList id="seasonRow"
            translation="[90, 490]"
            itemComponentName="ChipItem"
            itemSize="[1740, 52]"
            rowHeights="[52]"
            rowItemSize="[[200, 52]]"
            rowItemSpacing="[[14, 0]]"
            numRows="1"
            showRowLabel="[false]"
            focusXOffset="[0]"
            rowFocusAnimationStyle="floatingFocus"
            focusBitmapUri="pkg:/images/focus_ring.9.png"
            visible="false"/>
        <RowList id="episodeRow"
            translation="[90, 590]"
            itemComponentName="PosterItem"
            itemSize="[1740, 250]"
            rowHeights="[250]"
            rowItemSize="[[320, 250]]"
            rowItemSpacing="[[22, 0]]"
            numRows="1"
            showRowLabel="[false]"
            focusXOffset="[0]"
            rowFocusAnimationStyle="floatingFocus"
            focusBitmapUri="pkg:/images/focus_ring.9.png"
            visible="false"/>

        <Group id="panel" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000C0"/>
            <Rectangle translation="[360, 90]" width="1200" height="900" color="0x14141AFF"/>
            <Label id="panelTitle" text="" translation="[410, 118]" width="1100" height="90" wrap="true" maxLines="2" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="28"/>
            </Label>
            <LabelList id="streamList"
                translation="[400, 220]"
                itemSize="[1120, 64]"
                numRows="10"
                textHorizOffset="24"
                color="0xD8D8E0FF"
                focusedColor="0x0A0A0DFF"
                focusBitmapUri="pkg:/images/pill_white.9.png"
                focusFootprintBitmapUri="pkg:/images/pill_dim.9.png"/>
        </Group>
    </children>
    <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
    <script type="text/brightscript" uri="pkg:/source/I18n.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Storage.brs"/>
    <script type="text/brightscript" uri="pkg:/source/AddonStore.brs"/>
    <script type="text/brightscript" uri="pkg:/source/Streams.brs"/>
    <script type="text/brightscript" uri="pkg:/components/DetailsView.brs"/>
</component>
