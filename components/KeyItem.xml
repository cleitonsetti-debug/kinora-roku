<?xml version="1.0" encoding="UTF-8"?>
<component name="KeyItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange"/>
        <field id="width" type="float" onChange="onLayout"/>
        <field id="height" type="float" onChange="onLayout"/>
    </interface>
    <children>
        <Rectangle id="bg" color="0x1C1C22FF" width="100" height="50"/>
        <Label id="label" width="100" height="50" horizAlign="center" vertAlign="center" maxLines="1" color="0xF2F2F5FF">
            <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="20"/>
        </Label>
    </children>
    <script type="text/brightscript" uri="pkg:/components/KeyItem.brs"/>
</component>
